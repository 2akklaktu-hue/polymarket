# ШАБЛОН. Реальные значения сюда НЕ вписывать — этот файл попадает в git.
# Скопируй его в .env (тот в .gitignore) и заполняй только там.

# 1. Напиши @BotFather в Telegram -> /newbot -> скопируй токен в .env:
TELEGRAM_BOT_TOKEN=

# 2. Заполнится автоматически при запуске scripts/setup_telegram.py
TELEGRAM_CHAT_ID=

# 3. Необязательно: ключ ИИ для оценки дешёвых исходов по новостям
#    (scripts/22_longshots.py). Без ключа работают только другие площадки и
#    крупные игроки, а новости прикладываются заголовками без оценки.
#
#    Бесплатно: ключ с openrouter.ai (Keys -> Create key), 50 запросов в сутки.
OPENROUTER_API_KEY=
#    Платно: ключ Claude с console.anthropic.com. Если задан, используется он.
ANTHROPIC_API_KEY=

# Необязательные настройки. Пусто — значения по умолчанию.
# PM_OR_MODELS  — бесплатные модели OpenRouter через запятую, по порядку попыток
# PM_AI_MODEL   — модель Claude (по умолчанию claude-opus-5-5)
# PM_AI_PER_DAY — потолок оценок в сутки (16 для OpenRouter, 6 для Claude)
PM_OR_MODELS=
PM_AI_MODEL=
PM_AI_PER_DAY=
